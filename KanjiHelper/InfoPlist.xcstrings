    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Add event schedules to your calendar." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade los eventos a tu calendario." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "イベントの予定をカレンダーへ追加します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이벤트 일정을 캘린더에 추가합니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Adicione os eventos ao seu calendário." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将活动日程添加到您的日历。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將活動行程加入您的行事曆。" } }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use the camera to scan receipts, attach photos, and read event check-in QR codes." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa la cámara para leer recibos, adjuntar fotos y escanear códigos QR de registro." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レシートの読み取り、写真添付、イベント受付QRの読み取りにカメラを使用します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "영수증 인식, 사진 첨부 및 이벤트 접수 QR 코드 스캔에 카메라를 사용합니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Use a câmera para ler recibos, anexar fotos e escanear códigos QR de check-in." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用相机识别收据、附加照片并扫描活动签到二维码。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用相機辨識收據、附加照片並掃描活動報到QR。" } }
      }
    }
